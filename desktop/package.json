{
  "name": "workhelm-desktop",
  "productName": "Staffwarden",
  "version": "0.9.29",
  "private": true,
  "description": "Staffwarden desktop app: visible, consent-based time tracking.",
  "author": "Staffwarden",
  "main": "main.js",
  "workhelm": {
    "server": "https://staffwarden.com",
    "previousServers": [
      "https://workhelm.long-tooth-2e6b.workers.dev",
      "http://185.205.244.24"
    ],
    "updateKey": "-----BEGIN PUBLIC KEY-----\nMCowBQYDK2VwAyEAGwepj7JdgCEz5EVCz9sIcZA1462CWmuo89moq2lr0ZQ=\n-----END PUBLIC KEY-----"
  },
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "resedit": "1.7.2"
  },
  "build": {
    "appId": "com.amplifymediatechnologies.workhelm",
    "productName": "Staffwarden",
    "files": [
      "main.js",
      "preload.js",
      "renderer/**",
      "src/**",
      "assets/**"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "extendInfo": {
        "NSScreenCaptureUsageDescription": "Staffwarden captures screenshots while your timer is running."
      },
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "artifactName": "Staffwarden-${version}-${arch}.${ext}",
      "icon": "build/icon.png"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": false,
      "artifactName": "Staffwarden-Setup-${version}.${ext}"
    },
    "linux": {
      "target": "AppImage"
    },
    "copyright": "Copyright \u00a9 2026 Staffwarden",
    "directories": {
      "buildResources": "build"
    },
    "icon": "build/icon.png",
    "afterPack": "build/after-pack.js",
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Staffwarden",
      "runAfterFinish": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    },
    "dmg": {
      "title": "Workhelm ${version}"
    },
    "publish": null
  }
}
